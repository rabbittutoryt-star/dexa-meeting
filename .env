PORT=3000
APP_ENV=development
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
APP_ORIGIN=http://localhost:3000

# Optional: set to true to open the browser when server.py starts.
AUTO_OPEN_BROWSER=false

# Optional TURN server for reliable calls across strict NAT/firewalls.
# Example: turn:turn.example.com:3478
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# WebRTC mesh rooms are intentionally kept small.
MAX_ROOM_SIZE=8
